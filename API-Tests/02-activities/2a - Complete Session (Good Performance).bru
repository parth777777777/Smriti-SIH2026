meta {
  name: 2a - Complete Session (Good Performance)
  type: http
  seq: 2
}

post {
  url: {{node_url}}/activities/memory_match_v1/sessions/{{session_id}}/complete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

